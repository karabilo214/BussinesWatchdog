APP_NAME="Business Watchdog"
APP_ENV=local
APP_URL=http://localhost:8080

# Local infrastructure only. Replace before production.
POSTGRES_IMAGE=postgres:18
POSTGRES_DB=business_watchdog
POSTGRES_USER=bw_app
POSTGRES_PASSWORD=bw_local_password
POSTGRES_PORT=5432

REDIS_IMAGE=redis:8
REDIS_PORT=6379

MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z-cpuv1
MINIO_ROOT_USER=bw_minio
MINIO_ROOT_PASSWORD=bw_minio_local_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=business-watchdog-local

MAILPIT_IMAGE=axllent/mailpit:v1.31
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
