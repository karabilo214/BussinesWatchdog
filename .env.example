APP_NAME="Business Watchdog"
APP_ENV=local
APP_URL=http://localhost:8080

# Local infrastructure only. Replace before production.
POSTGRES_IMAGE=postgres:18
POSTGRES_DB=business_watchdog
POSTGRES_USER=bw_app
POSTGRES_PASSWORD=bw_local_password
POSTGRES_PORT=5432

REDIS_IMAGE=redis:8
REDIS_PORT=6379

S3_IMAGE=adobe/s3mock:5.2.2
S3_PORT=9090
S3_REGION=eu-central-1
S3_BUCKET=business-watchdog-local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

MAILPIT_IMAGE=axllent/mailpit:v1.31
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
