APP_NAME="Business Watchdog"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=business_watchdog
DB_USERNAME=bw_app
DB_PASSWORD=bw_local_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8080,127.0.0.1,127.0.0.1:8080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="watchdog@example.test"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_RETURN_PATH=
# Production only: publish SPF for MAIL_RETURN_PATH/MAIL_FROM_ADDRESS,
# publish DMARC at _dmarc.<from-domain>, and publish DKIM at
# <selector>._domainkey.<from-domain>. Local Mailpit does not need these.
MAIL_DKIM_ENABLED=false
MAIL_DKIM_PROVIDER_MANAGED=false
MAIL_DKIM_DOMAIN=
MAIL_DKIM_SELECTOR=
MAIL_DKIM_PRIVATE_KEY=
MAIL_DKIM_PRIVATE_KEY_PATH=
MAIL_DKIM_PASSPHRASE=

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=business-watchdog-local
AWS_ENDPOINT=http://s3:9090
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

WATCHDOG_KEYRING_CURRENT=1
WATCHDOG_KEYRING_V1=
WATCHDOG_KEYRING_KEYS=
WATCHDOG_CREDENTIAL_DRAINING_HOURS=24
WATCHDOG_RATE_LOGIN_PER_MINUTE=5
WATCHDOG_RATE_SIGNUP_PER_HOUR=3
WATCHDOG_RATE_PAIRING_PER_HOUR=20

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

WATCHDOG_BILLING_ENFORCEMENT=pilot
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_ACCOUNT_REF=default
