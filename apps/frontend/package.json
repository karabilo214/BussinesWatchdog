{
  "name": "business-watchdog-frontends",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "workspaces": [
    "packages/*",
    "customer",
    "control",
    "public"
  ],
  "scripts": {
    "check:palette": "node \"$npm_execpath\" run check:palette -w @bw/design",
    "check": "node \"$npm_execpath\" run check:palette -w @bw/design && node \"$npm_execpath\" run check --workspaces --if-present",
    "dev:customer": "node \"$npm_execpath\" run dev -w @bw/customer",
    "dev:control": "node \"$npm_execpath\" run dev -w @bw/control",
    "dev:public": "node \"$npm_execpath\" run dev -w @bw/public"
  }
}
