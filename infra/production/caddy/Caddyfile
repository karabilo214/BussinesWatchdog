# Static SPA CSP is generated from the bundle, never from a reused nonce.
(security) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
		-X-Powered-By
	}
	# Fallback for redirects/errors/static files; preserve upstream sandbox and nonce policies.
	header ?Content-Security-Policy "object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self'"
}

(app) {
	import security
	handle_errors {
		import security
		respond "Request failed" {err.status_code}
	}
	encode zstd gzip
	request_body {
		max_size 34MB
	}

	redir /app /app/
	handle_path /app/* {
		import /srv/web/current/customer/security.caddy
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server {
			hide *.caddy
		}
	}

	@control path /owner /owner/* /assets/*
	handle @control {
		import /srv/web/current/control/security.caddy
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server {
			hide *.caddy
		}
	}

	handle /site/assets/* {
		root * /srv/web/current/public

		header Cache-Control "public, max-age=31536000, immutable" {
			match status 200 206
		}

		file_server
	}

	handle /images/pages/* {
		root * /srv/web/current/public

		header Cache-Control "public, max-age=31536000, immutable" {
			match status 200 206
		}

		file_server
	}

	handle {
		root * /srv/web/current/public
		php_fastcgi app:9000 app-b:9000 {
			root /var/www/html/public
			lb_policy round_robin
			lb_try_duration 15s
			lb_try_interval 100ms
			fail_duration 10s
			health_uri /index.php/health/live
			health_interval 2s
			health_timeout 2s
		}
		file_server {
			hide .*
		}
	}
}

# Only for the certificate of the mail server (IMAP, SMTP); the mail container reads it from the caddy-data volume.
mail.{$SITE_DOMAIN} {
	import security
	import /srv/web/current/transport.caddy
	redir https://{$SITE_DOMAIN} permanent
}

www.{$SITE_DOMAIN} {
	import security
	import /srv/web/current/transport.caddy
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	import /srv/web/current/transport.caddy
	import app
}

# Test stores for checking the WooCommerce plugin and the Shopware App against the live service (infra/test-shops).
# Kept out of search engines; while they are not running these hosts answer 502.
(test_shop) {
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	encode zstd gzip
}

woo-test.{$SITE_DOMAIN} {
	import test_shop
	reverse_proxy bw-test-woo:80
}

shopware-test.{$SITE_DOMAIN} {
	import test_shop
	# Tools the dockware image ships for local development; never reachable from outside.
	@dockware path /adminer* /mailcatcher* /messages* /assets/* /logs* /server-status* /phpmyadmin*
	respond @dockware 404
	reverse_proxy bw-test-shopware:80
}

# Plain HTTP for the browser worker on the internal Docker network only (never published).
http://web:8080 {
	import app
}

# Explicit HTTP redirects use the same baseline headers (HSTS itself is HTTPS-only).
http://{$SITE_DOMAIN}, http://www.{$SITE_DOMAIN}, http://mail.{$SITE_DOMAIN} {
	import security
	redir https://{$SITE_DOMAIN}{uri} permanent
}
