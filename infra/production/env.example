# Production environment. The server copy lives at /opt/business-watchdog/.env (never commit it).
# Values marked GENERATE are filled once by deploy.sh init.

SITE_DOMAIN=business-watchdog.com
RELEASE=latest

APP_NAME="Business Watchdog"
APP_ENV=production
# Connector downloads stay closed until the exact build has passed its release checks.
WATCHDOG_CONNECTOR_RELEASE_GATE=true
WATCHDOG_WOO_APPROVED_SHA256=
WATCHDOG_SHOPWARE_APP_APPROVED_SHA256=
# Shopware Store app (docs/ops/shopware-store.md): technical name and the secret from the Shopware account.
WATCHDOG_SHOPWARE_STORE_APP_NAME=
WATCHDOG_SHOPWARE_STORE_APP_SECRET=
APP_DEBUG=false
APP_KEY=GENERATE
APP_URL=https://business-watchdog.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
# Caddy is the only way in (PHP-FPM is not published), so the forwarded scheme and client IP are trusted.
TRUSTED_PROXIES=*
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=business_watchdog
DB_USERNAME=bw_app
DB_PASSWORD=GENERATE

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
CACHE_STORE=redis

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=business-watchdog.com

# Screenshots, exports and site files on the server disk (volume "storage"); switch to S3 later if needed.
FILESYSTEM_DISK=local
WATCHDOG_ARTIFACTS_DISK=local
WATCHDOG_EXPORTS_DISK=local
WATCHDOG_SITE_MEDIA_DISK=local
WATCHDOG_SITE_BRAND_MEDIA_URL=

# Provider named in the sample privacy paragraph and LIA that customers copy for their stores (cabinet).
WATCHDOG_PROVIDER_NAME=
WATCHDOG_PROVIDER_ADDRESS=

# Mail: the "mail" container (Postfix + Dovecot, spam filter "rspamd") sends straight to recipients' servers and keeps
# the staff mailboxes; the service hands its letters over on the internal port 2525 and signs DKIM itself.
MAIL_MAILER=smtp
MAIL_HOST=mail
MAIL_PORT=2525
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@business-watchdog.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_RETURN_PATH=
MAIL_DKIM_ENABLED=true
MAIL_DKIM_DOMAIN=business-watchdog.com
MAIL_DKIM_SELECTOR=bw1
MAIL_DKIM_PRIVATE_KEY=GENERATE

WATCHDOG_KEYRING_CURRENT=1
WATCHDOG_KEYRING_V1=GENERATE

WATCHDOG_RELEASE=
WATCHDOG_BILLING_ENFORCEMENT=enforce
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_ACCOUNT_REF=default

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

WATCHDOG_SERVICE_ALERT_EMAIL=
BW_SYNC_WORKERS=2
BW_RECONCILIATION_WORKERS=2
BW_BROWSER_WORKERS=1
BW_WORKER_TOKEN=

# Off-site backups (Step 189): age public key (the private key stays with the owner, offline) and S3-compatible storage.
BW_BACKUP_KEEP_MONTHS=12
BW_BACKUP_AGE_RECIPIENT=
BW_BACKUP_S3_ENDPOINT=
BW_BACKUP_S3_BUCKET=
BW_BACKUP_S3_ACCESS_KEY=
BW_BACKUP_S3_SECRET_KEY=
