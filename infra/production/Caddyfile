(app) {
	encode zstd gzip
	request_body {
		max_size 34MB
	}

	redir /app /app/
	handle_path /app/* {
		root * /srv/customer
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	@control path /owner /owner/* /assets/*
	handle @control {
		root * /srv/control
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /var/www/html/public
		php_fastcgi app:9000
		file_server {
			hide .*
		}
	}
}

# Only for the certificate of the mail server (IMAP, SMTP); the mail container reads it from the caddy-data volume.
mail.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN} permanent
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
	import app
}

# Test stores for checking the WooCommerce plugin and the Shopware App against the live service (infra/test-shops).
# Kept out of search engines; while they are not running these hosts answer 502.
(test_shop) {
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	encode zstd gzip
}

woo-test.{$SITE_DOMAIN} {
	import test_shop
	reverse_proxy bw-test-woo:80
}

shopware-test.{$SITE_DOMAIN} {
	import test_shop
	# Tools the dockware image ships for local development; never reachable from outside.
	@dockware path /adminer* /mailcatcher* /messages* /assets/* /logs* /server-status* /phpmyadmin*
	respond @dockware 404
	reverse_proxy bw-test-shopware:80
}

# Plain HTTP for the browser worker on the internal Docker network only (never published).
http://web:8080 {
	import app
}
